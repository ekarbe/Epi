{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Epi Library" },
        { "path": "$DOCUMENT/Epi Library/**" }
      ]
    },
    "os:allow-platform",
    "store:allow-load",
    "store:allow-get",
    "store:allow-delete",
    "store:allow-save"
  ]
}
